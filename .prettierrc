{
  "singleQuote": true,
  "trailingComma": "all",
  "pluginSearchDirs": ["./frontend"],
  "overrides": [
    {
      "files": "./frontend/*",
      "options": {
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none",
        "printWidth": 100,
        "plugins": ["prettier-plugin-svelte"],
        "svelteBracketNewLine": true,
        "htmlWhitespaceSensitivity": "ignore"
      }
    },
    {
      "files": "./frontend/**/*.svelte",
      "options": {
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none",
        "printWidth": 100,
        "plugins": ["prettier-plugin-svelte"],
        "svelteBracketNewLine": true,
        "htmlWhitespaceSensitivity": "ignore",
        "parser": "svelte"
      }
    }
  ]
}
