{
	"name": "reiverr-frontend",
	"version": "3.0.0-beta.1",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/aleksilassila/reiverr"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode production --outDir ../backend/dist/dist",
		"build:here": "vite build --mode production",
		"build:tizen": "VITE_PLATFORM=tv vite build --mode production --outDir dist.tizen",
		"build:android": "VITE_PLATFORM=tv vite build --mode production --outDir dist.android",
		"preview": "npm run build && npm run --prefix backend start:prod",
		"preview:tizen": "npm run build:tizen && vite preview --outDir dist.tizen",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate:backend-openapi": "swagger-typescript-api generate -p \"../backend/swagger-spec.json\" -o src/lib/apis/reiverr -n reiverr.openapi.ts --axios --module-name-first-tag",
		"generate:tmdb-openapi": "swagger-typescript-api -p \"https://developer.themoviedb.org/openapi/64542913e1f86100738e227f\" -o src/lib/apis/tmdb -n tmdb-v3.openapi.ts --axios --module-name-first-tag --extract-response-body --api-class-name TmdbApiGenerated",
		"generate:tmdb-4-openapi": "swagger-typescript-api -p \"https://developer.themoviedb.org/openapi/6453cc549c91cf004cd2a015\" -o src/lib/apis/tmdb -n tmdb-v4.openapi.ts --axios --module-name-first-tag --extract-response-body --api-class-name TmdbApi4Generated"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.28.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tanstack/svelte-query": "^6.4.1",
		"@tanstack/svelte-query-devtools": "^6.4.1",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/axios": "^0.14.0",
		"@vitejs/plugin-legacy": "^8.2.4",
		"autoprefixer": "^10.4.16",
		"axios": "^1.6.2",
		"classnames": "^2.4.0",
		"cross-env": "^7.0.3",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.6.0",
		"hls.js": "^1.4.14",
		"jsdom": "^31.0.0",
		"openapi-fetch": "^0.8.2",
		"openapi-typescript": "^6.7.5",
		"postcss": "^8.4.35",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"radix-icons-svelte": "^1.2.1",
		"reflect-metadata": "^0.1.13",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-i18n": "^4.0.1",
		"swagger-typescript-api": "13.2.8",
		"tailwind-scrollbar-hide": "^1.1.7",
		"tailwindcss": "^3.4.17",
		"terser": "^5.26.0",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-singlefile": "^2.3.4",
		"vitest": "^4.1.2"
	},
	"browserslist": {
		"production": [
			"supports es6-module"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"gsap": "^3.12.5"
	}
}
